# ============================================================
# CodeClarity AI - Environment Configuration Example
# ============================================================

# 1. Google Gemini API Key
# Obtain for free at: https://aistudio.google.com/apikey
# Leave empty if testing offline with the built-in educational tutor or using Ollama
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Gemma 4 Model Identifier on Gemini API
# Official Gemma 4 identifier: gemma-4-26b-a4b-it
# Documentation: https://ai.google.dev/gemma/docs/core/gemma_on_gemini_api
GEMMA_MODEL_NAME=gemma-4-26b-a4b-it

# 3. Provider Mode: "auto", "google", or "ollama"
# "auto": uses Google if GEMINI_API_KEY is set, else tests Ollama, else educational fallback
AI_PROVIDER=auto

# 4. Local Ollama Settings (Optional)
# If using Ollama locally (e.g. `ollama run gemma4`):
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL_NAME=gemma4

# 5. Application Limits
MAX_IMAGE_SIZE_MB=5
